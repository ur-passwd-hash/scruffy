    {"archetype": "saas-dashboard", "reference_heading": "SaaS dashboard or operations surface", "prompt": "Audit an operations dashboard with filters, tables, alerts, and role-based data.", "required_probes": ["decision-purpose", "filter-clear", "stale-data", "drill-down-return", "permissions", "dense-keyboard"]},
