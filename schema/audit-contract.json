{
  "schema_version": "1.0",
  "current_registry_schema": "2.1",
  "legacy_registry_schemas": [
    "2.0"
  ],
  "run": {
    "modes": [
      {
        "key": "audit",
        "label": "AUDIT",
        "repository_writes_allowed": false,
        "live_demonstration_allowed": false,
        "description": "Inspect and report on an existing target without changing its source."
      },
      {
        "key": "redesign",
        "label": "REDESIGN",
        "repository_writes_allowed": true,
        "live_demonstration_allowed": true,
        "description": "Audit, establish a coherent direction, implement authorized source changes, and verify them."
      },
      {
        "key": "design",
        "label": "DESIGN",
        "repository_writes_allowed": true,
        "live_demonstration_allowed": true,
        "description": "Create an authorized new interface after establishing the product frame and exploring structural directions."
      },
      {
        "key": "demonstrate_fix",
        "label": "DEMONSTRATE-FIX",
        "repository_writes_allowed": false,
        "live_demonstration_allowed": true,
        "description": "Demonstrate reversible live-page changes without representing them as repository changes."
      }
    ],
    "mode_selection_basis": [
      "explicit",
      "inferred"
    ],
    "blind_statuses": [
      "not_run",
      "verified",
      "contaminated"
    ],
    "authority_states": [
      "authorized",
      "not_authorized"
    ],
    "authority_basis_types": [
      "explicit_request",
      "not_granted"
    ]
  },
